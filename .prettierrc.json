{
    "$schema": "https://json.schemastore.org/prettierrc",
    "semi": false,
    "singleQuote": true,
    "printWidth": 100,
    "trailingComma": "all",
    "tabWidth": 4,
    "endOfLine": "lf",
    "bracketSpacing": true,
    "bracketSameLine": true,
    "vueIndentScriptAndStyle": false,
    "singleAttributePerLine": true
}
